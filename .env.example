# Copy this file to ".env" and fill in your values.
# NEVER commit your real ".env" (it is git-ignored) — it holds your secrets.

# ---- MongoDB connection ----
# Your MongoDB connection string. You can either:
#  (A) put the full string with credentials here, e.g.
#      MONGODB_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#  (B) OR leave the credentials out of the URL and set MONGODB_USERNAME /
#      MONGODB_PASSWORD below (recommended if your password has special
#      characters like '@', ':' or '/').
MONGODB_URL=mongodb+srv://cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: database credentials (special characters are handled for you).
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Name of the database to use inside MongoDB.
MONGODB_DB=chattingsystem

# ---- Collection / bucket names (optional; these are the defaults) ----
# Override only if you want different names in MongoDB.
USERS_COLLECTION=users
CHATS_COLLECTION=chats
MESSAGES_COLLECTION=messages
# GridFS bucket for uploaded files (creates "<name>.files" / "<name>.chunks").
UPLOADS_BUCKET=uploads

# ---- Web Push notifications (optional) ----
# Generate a VAPID keypair (both are base64url strings). Leaving these empty
# disables push notifications (the app still works, just no closed-tab alerts).
# You can generate a pair with any VAPID tool, e.g. the `vapid` CLI from py_vapid.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact used by push services (a mailto: address or your site URL).
VAPID_SUBJECT=mailto:admin@example.com

# ---- Collection for stored push subscriptions ----
PUSH_SUBSCRIPTIONS_COLLECTION=push_subscriptions

# ---- Security limits ----
# Max upload size in MB, max characters per message, and max WebSocket messages
# per 10 seconds per connection.
MAX_UPLOAD_MB=10
MAX_MESSAGE_LENGTH=4000
WS_RATE_LIMIT=40
# Allowed browser origins for the WebSocket (comma-separated). Leave EMPTY to
# automatically enforce same-origin (recommended). Example for a fixed domain:
# ALLOWED_ORIGINS=https://yourapp.onrender.com
ALLOWED_ORIGINS=

# ---- Logging ----
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
